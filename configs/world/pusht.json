{
  "data": {
    "dataset": {
      "frameskip": 5,
      "keys_to_cache": [
        "action",
        "proprio",
        "state"
      ],
      "keys_to_load": [
        "pixels",
        "action",
        "proprio",
        "state"
      ],
      "name": "pusht_expert_train.h5",
      "num_steps": 4
    }
  },
  "embed_dim": 192,
  "history_size": 3,
  "img_size": 224,
  "loader": {
    "batch_size": 128,
    "num_workers": 2,
    "persistent_workers": true,
    "pin_memory": true,
    "prefetch_factor": 1
  },
  "loss": {
    "sigreg": {
      "kwargs": {
        "knots": 17,
        "num_proj": 1024
      },
      "weight": 0.09
    }
  },
  "model": {
    "_target_": "lgdkgp.models.world.jepa.JEPA",
    "action_encoder": {
      "_target_": "lgdkgp.models.world.blocks.Embedder",
      "emb_dim": 192,
      "input_dim": 10
    },
    "encoder": {
      "_target_": "stable_pretraining.backbone.utils.vit_hf",
      "image_size": 224,
      "patch_size": 14,
      "pretrained": false,
      "size": "tiny",
      "use_mask_token": false
    },
    "pred_proj": {
      "_target_": "lgdkgp.models.world.blocks.MLP",
      "hidden_dim": 2048,
      "input_dim": 192,
      "norm_fn": {
        "_partial_": true,
        "_target_": "torch.nn.BatchNorm1d"
      },
      "output_dim": 192
    },
    "predictor": {
      "_target_": "lgdkgp.models.world.blocks.ARPredictor",
      "depth": 6,
      "dim_head": 64,
      "dropout": 0.1,
      "emb_dropout": 0.0,
      "heads": 16,
      "hidden_dim": 192,
      "input_dim": 192,
      "mlp_dim": 2048,
      "num_frames": 3,
      "output_dim": 192
    },
    "projector": {
      "_target_": "lgdkgp.models.world.blocks.MLP",
      "hidden_dim": 2048,
      "input_dim": 192,
      "norm_fn": {
        "_partial_": true,
        "_target_": "torch.nn.BatchNorm1d"
      },
      "output_dim": 192
    }
  },
  "num_preds": 1,
  "num_workers": 2,
  "optimizer": {
    "lr": 5e-05,
    "type": "AdamW",
    "weight_decay": 0.001
  },
  "output_model_name": "kernel_prior_pusht/lewm",
  "seed": 2027,
  "subdir": "kernel_prior_pusht",
  "train_split": 0.9,
  "trainer": {
    "accelerator": "gpu",
    "devices": 1,
    "gradient_clip_val": 1.0,
    "max_epochs": 10,
    "precision": "bf16"
  },
  "wandb": {
    "enabled": false
  }
}
